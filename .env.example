# =============================================================================
# TradingAgents — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ── LLM Providers (set the one you use) ──────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Options: openai | anthropic | google | xai | deepseek | ollama
LLM_PROVIDER=openai
DEEP_MODEL=gpt-4o
QUICK_MODEL=gpt-4o-mini

# ── Alpaca (for autonomous trading execution) ─────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true          # set to false for live trading

# ── Quiver Quant (Capitol Trades data) ───────────────────────────────────────
QUIVER_API_KEY=your_quiver_api_key

# ── Strategy Parameters ───────────────────────────────────────────────────────
TRAIL_PCT=0.05             # 5% trailing stop floor
WHEEL_DTE=30               # target 30 days to expiry for options

# ── Django Dashboard ──────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
WEB_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=tradingagents
DB_USER=tradingagents
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Cloudflare Tunnel (optional) ──────────────────────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token
