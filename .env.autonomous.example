# ──────────────────────────────────────────────────────────────────────────────
# .env.autonomous.example
# Copy this file to .env and fill in your credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (TradingAgents analysis engine) ──────────────────────────────
# Choose one provider and set its key:
OPENAI_API_KEY=your_openai_key_here
# GOOGLE_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_claude_key_here
# XAI_API_KEY=your_grok_key_here

# LLM model selection (optional — defaults shown)
LLM_PROVIDER=openai
DEEP_MODEL=gpt-4o
QUICK_MODEL=gpt-4o-mini

# ── Alpaca Brokerage ───────────────────────────────────────────────────────────
# Get your keys at: https://app.alpaca.markets/paper-trading (paper)
# or https://app.alpaca.markets (live)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Set to 'true' to use live trading (default: paper)
ALPACA_LIVE=false

# ── Quiver Quantitative / Capitol Trades ──────────────────────────────────────
# Get your API key at: https://www.quiverquant.com/
# Free tier available with limited requests.
QUIVER_API_KEY=your_quiver_api_key_here

# ── Market Data ───────────────────────────────────────────────────────────────
# Optional: Alpha Vantage for enhanced fundamental/news data
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ── Strategy Parameters ───────────────────────────────────────────────────────
# Trailing stop percentage (default: 5%)
TRAIL_PCT=0.05

# Wheel strategy days-to-expiry target (default: 30)
WHEEL_DTE=30
